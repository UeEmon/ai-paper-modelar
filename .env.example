# Copy to .env. NEVER commit secrets.
AI_PROVIDER=none
# Supported providers: none, openai, gemini, anthropic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# SenroLab 連携（/v1/nets）のトークン。設定すると Authorization: Bearer <トークン> を確かめる
PAPERCRAFT_API_TOKEN=
