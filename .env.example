# AIキーは.envに置かず、ブラウザの「生成AIの設定」で暗号化保存します。
# SenroLab 連携（/v1/nets）のトークン。設定すると Authorization: Bearer <トークン> を確かめる
PAPERCRAFT_API_TOKEN=

# 任意: ローカルLLMの許可URL（カンマ区切り）。指定時は既定リストを置換。
# 未指定なら localhost / 127.0.0.1 / [::1] / host.docker.internal の
# :11434 と :1234/v1 を許可。空文字でローカル接続をすべて無効化。
# PAPER_MODELAR_LOCAL_AI_URLS=http://host.docker.internal:11434,http://host.docker.internal:1234/v1
